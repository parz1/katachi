      "idle": {
        "$type": "duration",
        "$value": {
          "value": 800,
          "unit": "ms"
        },
        "$description": "停止输入多久后自动保存。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "Kotolog apps/mobile/src/features/detail/useDetailEditor.ts"
          }
        }
      }
    },
    "search": {
      "debounce": {
        "$type": "duration",
        "$value": {
          "value": 180,
          "unit": "ms"
        },
        "$description": "输入停顿多久后才查询。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "Kotolog packages/product-ui/src/components/app-shell/AppCommandPalette.tsx"
          }
        }
      }
    },
    "loading": {
      "delay": {
        "$type": "duration",
        "$value": {
          "value": 300,
          "unit": "ms"
        },
        "$description": "这么久内有结果就不显示加载指示。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "agent 提案，Kotolog 没有定义"
          }
        }
      }
    },
    "select": {
      "settle": {
        "$type": "duration",
        "$value": {
          "value": 220,
          "unit": "ms"
        },
        "$description": "方向键换选中项时，选中停稳这么久才加载详情。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "Kotolog docs/object-forms.md",
            "platforms": [
              "web",
              "desktop"
            ]
          }
        }
      }
    },
    "drag": {
      "threshold": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "按下后移动超过这个距离才算拖动。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "Kotolog docs/object-forms.md",
            "platforms": [
              "web",
              "desktop"
            ]
          }
        }
      },
      "long-press": {
        "$type": "duration",
        "$value": {
          "value": 330,
          "unit": "ms"
        },
        "$description": "触屏宽窗里，按住条这么久才能拖动。",
        "$extensions": {
          "local.katachi": {
            "status": "draft",
            "source": "Kotolog docs/object-forms.md",
            "platforms": [
              "adaptive"
            ]
          }
        }
      }
    }
  }
}
