    "contrast": {
      "$type": "number",
      "text": {
        "$value": 4.5,
        "$description": "普通文字与背景的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.3 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      },
      "text-large": {
        "$value": 3,
        "$description": "大号文字（按 WCAG 定义）与背景的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.3 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      },
      "non-text": {
        "$value": 3,
        "$description": "控件边界、图标、焦点指示等与相邻颜色的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.11 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      }
    },
