{
  "$description": "katachi 设计数值的唯一来源，格式为 DTCG Format Module 2025.10。constraint 来自标准和平台规范；type 和 color 是提案，用户还没确认。",
  "constraint": {
    "$description": "外部标准或平台规范给出的数值，用于检查和判断，不代表审美偏好。",
    "contrast": {
      "$type": "number",
      "text": {
        "$value": 4.5,
        "$description": "普通文字与背景的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.3 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      },
      "text-large": {
        "$value": 3,
        "$description": "大号文字（按 WCAG 定义）与背景的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.3 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      },
      "non-text": {
        "$value": 3,
        "$description": "控件边界、图标、焦点指示等与相邻颜色的最低对比度。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "WCAG 2.2 SC 1.4.11 (AA)",
            "platforms": [
              "web",
              "desktop",
              "mobile",
              "adaptive"
            ]
          }
        }
      }
    },
    "target": {
