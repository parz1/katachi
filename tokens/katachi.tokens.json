              "adaptive"
            ]
          }
        }
      },
      "width-extra-large-min": {
        "$value": 1600,
        "$description": "窗口宽度进入 extra-large 的分界，单位 dp。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "Android Developers, Use window size classes",
            "platforms": [
              "adaptive"
            ]
          }
        }
      },
      "height-medium-min": {
        "$value": 480,
        "$description": "窗口高度进入 medium 的分界，单位 dp。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "Android Developers, Use window size classes",
            "platforms": [
              "adaptive"
            ]
          }
        }
      },
      "height-expanded-min": {
        "$value": 900,
        "$description": "窗口高度进入 expanded 的分界，单位 dp。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "Android Developers, Use window size classes",
            "platforms": [
              "adaptive"
            ]
          }
        }
      }
    },
    "terminal": {
      "$type": "number",
      "columns-default": {
        "$value": 80,
        "$description": "终端常见的默认列数。用户可以改变，这只是检查的起点。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "VT100 的默认尺寸，许多终端沿用（事实标准）",
            "platforms": [
              "terminal"
            ]
          }
        }
      },
      "rows-default": {
        "$value": 24,
        "$description": "终端常见的默认行数。用户可以改变，这只是检查的起点。",
        "$extensions": {
          "local.katachi": {
            "status": "standard",
            "source": "VT100 的默认尺寸，许多终端沿用（事实标准）",
            "platforms": [
              "terminal"
            ]
          }
        }
      }
    }
  },
  "object": {
    "$description": "对象的四种形态（条、卡、页、窗）的数值。来自 Kotolog，还没有定稿，说明见 patterns/object-forms.md。",
